# URL base de la API (sin barra final). En Render, la URL de tu servicio backend.
# ⚠️ El prefijo NEXT_PUBLIC_ es obligatorio: es lo único que Next.js expone
#    al browser. Si esta variable se llama distinto (ej. VITE_API_URL, que
#    es de Vite, no de Next.js), src/lib/api.ts cae a BASE='' en silencio
#    y todos los fetch van a rutas relativas del propio frontend (404).
NEXT_PUBLIC_API_URL=https://app-chny.onrender.com

# Login con Google (punto 5/E5, pendientes-2026-08-15.md) — Google Cloud
# Console → APIs & Services → Credentials → OAuth client ID (tipo "Web
# application"). El MISMO Client ID que GOOGLE_CLIENT_ID en el backend
# (render.yaml) -- es público por diseño de OAuth, no un secreto. Sin
# esta variable, GoogleSignInButton no renderiza nada (no un botón roto).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=